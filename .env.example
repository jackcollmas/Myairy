APP_URL="http://localhost:3000"

# Security PIN code for lock screen (default: 1234)
PIN_CODE="1234"

# Optional MongoDB Connection String (falls back to local JSON file persistence if omitted)
MONGODB_URI="mongodb://localhost:27017/myairy"

# Groq API Key for AI chat functionality
# Get your API key from: https://console.groq.com/keys
GROQ_API_KEY="your_groq_api_key_here"

# Cloudinary Configuration for Image Uploads
# Get your credentials from: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"
